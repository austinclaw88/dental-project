# Cloud database (per TDD: Postgres)
DATABASE_URL=postgres://nightshift:nightshift@127.0.0.1:5432/nightshift
# Practice-side OpenDental simulator database
ODSIM_DATABASE_URL=postgres://nightshift:nightshift@127.0.0.1:5432/odsim

API_PORT=4000
API_BASE_URL=http://127.0.0.1:4000
DASHBOARD_PORT=3000
PORTAL_PORT=4300
PORTAL_URL=http://127.0.0.1:4300

# Shared secret between connector and cloud API (dev only)
CONNECTOR_TOKEN=dev-connector-token

# Filesystem stand-in for the object store (screenshots, DOM captures, call transcripts)
ARTIFACTS_DIR=./var/artifacts

# Extraction provider: "heuristic" (deterministic, default for dev/tests) or "anthropic"
EXTRACTOR=heuristic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
